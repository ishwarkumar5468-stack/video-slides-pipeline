# Copy this file to .env and fill in your keys

# Claude API key - used for script -> scene breakdown
ANTHROPIC_API_KEY=your_anthropic_key_here

# Free-tier stock photo/video API - https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here

# Free-tier AI image generation API (example: Stability AI free tier)
STABILITY_API_KEY=your_stability_key_here

# Server port
PORT=3000
